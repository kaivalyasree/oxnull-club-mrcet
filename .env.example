# ==============================================================================
# 0XNULL Cybersecurity Club — Environment Configuration Template
# ==============================================================================
# Safe placeholder template. DO NOT commit production credentials to source control.

# ------------------------------------------------------------------------------
# 1. Administrator Authentication & Authorization (Required for /admin)
# ------------------------------------------------------------------------------
# Comma-separated list of authorized administrator email addresses.
# Authorized addresses: mvreddyinfosec@gmail.com, cyberwithak1@gmail.com
ADMIN_EMAILS=mvreddyinfosec@gmail.com,cyberwithak1@gmail.com

# Cryptographically secure random secret (min 32 chars) for signing HttpOnly admin session cookies.
# Generate on Linux/Mac: openssl rand -base64 32
# Generate on Windows PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
ADMIN_SESSION_SECRET=replace_with_a_secure_random_string_at_least_32_characters_long

# ------------------------------------------------------------------------------
# 2. Email Delivery Provider (Required for live Admin OTP delivery)
# ------------------------------------------------------------------------------
# Strategy Option A: Standard SMTP (e.g. Gmail App Password, AWS SES, Brevo, Mailgun)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-account@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM=0XNULL Security <no-reply@0xnull.org>

# Strategy Option B: Resend Transactional Email API (Alternative to SMTP)
RESEND_API_KEY=re_your_resend_api_key_here

# ------------------------------------------------------------------------------
# 3. Next.js Public Site URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 4. Supabase & PostgreSQL Credentials (Optional / Production Database)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Direct PostgreSQL pooling connection string
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 5. Optional Google OAuth Credentials (for Supabase Google Provider)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
